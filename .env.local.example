
# Sentry (Fehler-Monitoring, EU-Region). Ohne DSN ist Sentry deaktiviert.
# DSN: Sentry → Project Settings → Client Keys (DSN). Wird beim Build eingebettet.
NEXT_PUBLIC_SENTRY_DSN=
# Optional: z.B. production, preview, local (Default: NODE_ENV)
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Nur für Sourcemap-Upload beim Build (CI/Hosting), nicht lokal nötig.
# Org-Slug + Projekt-Slug aus der Sentry-URL, Auth-Token: Settings → Auth Tokens.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
